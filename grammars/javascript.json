{
  "name": "JavaScript",
  "scopeName": "source.js",
  "type": "tree-sitter",
  "parser": "tree-sitter-javascript",
  "injectionNames": ["js", "javascript", "jsx", "node"],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-javascript#v0.25.0",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "javascript.wasm",
    "highlightsQuery": "javascript-highlights.scm",
    "localsQuery": "javascript-locals.scm",
    "foldsQuery": "javascript-folds.scm",
    "indentsQuery": "javascript-indents.scm",
    "tagsQuery": "javascript-tags.scm",
    "injectionsQuery": "javascript-injections.scm"
  },
  "firstLineRegex": [
    // shebang line
    "^#!.*\\b(node)\\r?\\n",
    // vim modeline
    // Stop at the first Vim and set tokens instead of backtracking over them.
    // \x0a keeps existing shebang prefix line counts unchanged.
    "(?:^|\\x0a)(?:(?!vim\\b).)*vim\\b(?:(?!\\bset\\b).)*\\bset\\b.*\\b(filetype|ft|syntax)=(js|javascript)"
  ],
  "fileTypes": ["js", "cjs", "mjs", "jsx"],
  "comments": {
    "start": "// ",
    "block": ["/*", "*/"],
    "line": "//"
  }
}
