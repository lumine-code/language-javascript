{
  ".source.js": {
    "editor": {
      "nonWordCharacters": "/\\()\"':,.;<>~!@%^&*|+=[]{}`?-…",
      "commentStart": "// ",
      "commentDelimiters": {
        "block": ["/*", "*/"],
        "line": "//"
      }
    },
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\"", "''", "``"]
    }
  },
  ".meta.block.jsx.js": {
    "editor": {
      "commentStart": "{/*",
      "commentEnd": "*/}",
      "commentDelimiters": {
        "block": ["{/*", "*/}"]
      }
    }
  },
  ".meta.jsx.inside-tag.js": {
    "editor": {
      "commentStart": "{/*",
      "commentEnd": "*/}",
      "commentDelimiters": {
        "block": ["{/*", "*/}"]
      }
    }
  },
  ".meta.embedded.code.jsx.js": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "line": "//",
        "block": ["/*", "*/"]
      }
    }
  }
}
